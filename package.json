{
  "name": "think-in-english",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter think-in-english-frontend --filter think-in-english-backend dev",
    "dev:frontend": "pnpm --filter think-in-english-frontend dev",
    "dev:backend": "pnpm --filter think-in-english-backend dev",
    "build": "pnpm --filter think-in-english-frontend build",
    "start:backend": "pnpm --filter think-in-english-backend start",
    "seed:phrases": "pnpm --filter think-in-english-backend seed:phrases"
  }
}
